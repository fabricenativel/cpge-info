                           <pdfaProperty:category>internal</pdfaProperty:category>
                           <pdfaProperty:description>Part of ISO 14289 standard</pdfaProperty:description>
                        </rdf:li>
                     </rdf:Seq>
                  </pdfaSchema:property>
               </rdf:li>
